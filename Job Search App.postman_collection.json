        {
          "name": "Get Users and companies GQL",
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{accessToken}}",
                  "type": "string"
                }
              ]
            },
            "method": "POST",
            "header": [],
            "body": {
              "mode": "graphql",
              "graphql": {
                "query": "query GetCompanies {\r\n    getCompanies {\r\n        data {\r\n            _id\r\n            id\r\n            companyName\r\n            companyEmail\r\n            description\r\n            industry\r\n            address\r\n            numberOfEmployees\r\n            website\r\n            HRs {\r\n                id\r\n                firstName\r\n                email\r\n                lastName\r\n            }\r\n            approvedByAdmin\r\n            bannedAt\r\n            deletedAt\r\n            createdAt\r\n            updatedAt\r\n            createdBy {\r\n                id\r\n                lastName\r\n                firstName\r\n                username\r\n                email\r\n            }\r\n            legalAttachment {\r\n                public_id\r\n                secure_url\r\n            }\r\n        }\r\n        metadata {\r\n            page\r\n            limit\r\n            total\r\n            totalPages\r\n            hasNext\r\n            hasPrev\r\n        }\r\n    }\r\n    getUsers {\r\n        metadata {\r\n            page\r\n            limit\r\n            total\r\n            totalPages\r\n            hasNext\r\n            hasPrev\r\n        }\r\n        data {\r\n            _id\r\n            id\r\n            firstName\r\n            lastName\r\n            username\r\n            email\r\n            bio\r\n            mobileNumber\r\n            DOB\r\n            gender\r\n            role\r\n            provider\r\n            isConfirmed\r\n            bannedAt\r\n            deletedAt\r\n            createdAt\r\n            updatedAt\r\n        }\r\n    }\r\n}\r\n",
                "variables": ""
              }
            },
