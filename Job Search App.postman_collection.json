        {
          "name": "Refresh  Access Token",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "// 1. Validate response status code\r\npm.test(\"Check if the response status code is 200\", function () { \r\n    pm.response.to.have.status(200);\r\n});\r\n\r\n// 2. Safely validate response structure and automate token storage\r\npm.test(\"Check and store access and refresh tokens\", function () { \r\n    // Parse JSON response once to optimize performance\r\n    const responseBody = pm.response.json();\r\n    \r\n    // Ensure the response contains the expected data structure\r\n    pm.expect(responseBody).to.have.property('data');\r\n    pm.expect(responseBody.data.accessToken).to.not.be.null;\r\n\r\n\r\n    // 3. Environment variables are set only if the assertions above pass successfully\r\n    pm.environment.set(\"accessToken\", responseBody.data.accessToken);\r\n    pm.environment.set(\"refreshToken\", responseBody.data.refreshToken);\r\n\r\n    \r\n    console.log(\"accessToken have been automatically updated in Environment!\");\r\n});\r\n\r\n\r\n"
                ]
              }
            }
          ],
